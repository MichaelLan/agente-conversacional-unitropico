{
  "name": "unitropico-rag",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  // Internal service: reachable only through the API's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GENERATION_MODEL": "openai/gpt-6-luna",
    "EMBEDDING_MODEL": "openai/text-embedding-3-small",
    "EMBEDDING_DIMENSIONS": 1536,
    "RETRIEVAL_MODE": "hybrid",
    // Sources sent to the model; the input budget must fit them (README).
    "ANSWER_EVIDENCE_LIMIT": 8,
    "GENERATION_MAX_INPUT_CHARS": 32000,
    // Retrieval question for follow-ups: none | concat | rewrite (rewrite adds
    // one LLM call per follow-up with the same GENERATION_MODEL and falls back
    // to concat on any failure; see README "Conversación y alcance").
    "FOLLOWUP_STRATEGY": "rewrite",
    "FOLLOWUP_REWRITE_MAX_TOKENS": 256,
    "FOLLOWUP_REWRITE_TIMEOUT_SECONDS": 8,
    // Minimum Vectorize cosine score (0..1]; empty = disabled (not calibrated).
    "MIN_RELEVANCE": ""
  },
  // Secret (wrangler secret put): AI_GATEWAY_API_KEY.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unitropico",
      // PLACEHOLDER: replace with the id printed by `wrangler d1 create unitropico`
      // once creating the remote database is authorized. Local dev ignores it.
      "database_id": "af5162b0-ce3d-4669-97dc-a82dad02c4d8",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  // Index not created yet (see infra/vectorize/README.md). Vectorize has no
  // local emulation: under `pywrangler dev --local` this binding is unusable.
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "unitropico-chunks-1536" }
  ]
}
