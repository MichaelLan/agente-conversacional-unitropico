{
  "name": "unitropico-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "services": [{"binding": "RAG", "service": "unitropico-rag"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unitropico",
      "database_id": "af5162b0-ce3d-4669-97dc-a82dad02c4d8",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "r2_buckets": [{"binding": "DOCUMENTS", "bucket_name": "unitropico-documents"}],
  "workflows": [
    {
      "binding": "INGESTION",
      "name": "ingestion",
      "class_name": "IngestionWorkflow",
      "script_name": "unitropico-ingestion"
    }
  ],
  "ratelimits": [
    {"name": "CHAT_LIMITER", "namespace_id": "1001", "simple": {"limit": 20, "period": 60}},
    {"name": "RETRIEVAL_LIMITER", "namespace_id": "1002", "simple": {"limit": 30, "period": 60}},
    {"name": "ADMIN_AUTH_LIMITER", "namespace_id": "1003", "simple": {"limit": 10, "period": 60}}
  ]
}
